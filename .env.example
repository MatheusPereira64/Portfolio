# Chatbot com IA: a chave do Gemini fica só no servidor do proxy.
# Não defina a chave numa variável VITE_* — o Vite colocaria o valor no JavaScript público.
# Ver api/gemini-proxy.example.mjs (secret GEMINI_API_KEY no worker, não no cliente).
# VITE_GEMINI_PROXY_URL=https://your-worker.workers.dev

# EmailJS — formulário de contacto → matheuspereira6464@gmail.com
# 1. Crie conta em https://www.emailjs.com/
# 2. Adicione um Email Service (ex.: Gmail) ligado ao seu email
# 3. Crie um Email Template com campos: {{from_name}}, {{from_email}}, {{reply_to}}, {{subject}}, {{message}}
#    Destinatário (To): matheuspereira6464@gmail.com
# 4. Copie este ficheiro para .env e preencha os IDs abaixo
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Plausible Analytics (opcional). Crie a conta em https://plausible.io
# Se vazio, o site usa SITE_PROFILE.plausibleDomain (matheuspereira64.github.io)
# VITE_PLAUSIBLE_DOMAIN=matheuspereira64.github.io
